{
  "name": "@drift/desktop",
  "productName": "Drift",
  "version": "0.1.3",
  "private": true,
  "description": "Drift \u2014 terminal + SSH sessions with Cursor agent",
  "author": "doob9p",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/doob9p/drift-app.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild:native": "electron-rebuild -f -w node-pty -m ../..",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish never",
    "release:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "@drift/agent-cursor": "*",
    "@drift/core": "*",
    "@drift/host-local": "*",
    "@drift/host-ssh": "*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.11",
    "lucide": "^1.71.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.13.10",
    "electron": "35.7.5",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
