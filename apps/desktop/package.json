{
  "name": "@drift/desktop",
  "productName": "Drift",
  "version": "0.1.5",
  "private": true,
  "description": "Drift — terminal + SSH sessions with Cursor agent",
  "author": "doob9p",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/doob9p/drift-app.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild:native": "electron-rebuild -f -w node-pty -m ../..",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish never",
    "release:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish always",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "release:win": "npm run build && electron-builder --win --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@drift/agent-cursor": "*",
    "@drift/core": "*",
    "@drift/host-local": "*",
    "@drift/host-ssh": "*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.11",
    "lucide": "^1.71.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.13.10",
    "electron": "35.7.5",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
